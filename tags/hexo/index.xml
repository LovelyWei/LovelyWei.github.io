&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">-a---- 2019/8/21 13:53 135764 package-lock.json
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">-a---- 2019/8/21 13:53 629 package.json
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">-a---- 2019/8/21 14:17 1962 _config.yml
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>接下来运行&lt;/p>
&lt;blockquote>
&lt;p>hexo server&lt;/p>
&lt;/blockquote>
&lt;p>会见到类似&lt;/p>
&lt;div class="highlight">&lt;div class="chroma">
&lt;table class="lntable">&lt;tr>&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code>&lt;span class="lnt">1
&lt;/span>&lt;span class="lnt">2
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
