&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="err">v8:&lt;/span> &lt;span class="err">&amp;#39;7.0.276.38-node.16&amp;#39;,&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="err">zlib:&lt;/span> &lt;span class="err">&amp;#39;1.2.11&amp;#39;&lt;/span> &lt;span class="p">}&lt;/span>
